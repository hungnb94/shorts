{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Short-Form Media Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_sha256",
    "editorial_score",
    "category_scores",
    "blocking_defects",
    "findings",
    "verdict",
    "limitations"
  ],
  "properties": {
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "editorial_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "category_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "expectation_open_loop",
        "visual_proof_progression",
        "captions_mobile",
        "voice_sound_mix",
        "pacing",
        "cta_payoff_ending",
        "technical_compliance"
      ],
      "properties": {
        "hook": {"type": "integer", "minimum": 0, "maximum": 25},
        "expectation_open_loop": {"type": "integer", "minimum": 0, "maximum": 10},
        "visual_proof_progression": {"type": "integer", "minimum": 0, "maximum": 15},
        "captions_mobile": {"type": "integer", "minimum": 0, "maximum": 10},
        "voice_sound_mix": {"type": "integer", "minimum": 0, "maximum": 15},
        "pacing": {"type": "integer", "minimum": 0, "maximum": 10},
        "cta_payoff_ending": {"type": "integer", "minimum": 0, "maximum": 10},
        "technical_compliance": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "blocking_defects": {
      "type": "array",
      "items": {"type": "string"}
    },
    "findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "timestamp", "evidence", "action", "expected_gain"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 3},
          "timestamp": {"type": "string"},
          "evidence": {"type": "string"},
          "action": {"type": "string"},
          "expected_gain": {"type": "integer", "minimum": 0, "maximum": 20}
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["revise", "editorial_target_met", "blocked_external"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
