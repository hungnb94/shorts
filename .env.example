# YouTube Analytics API OAuth credentials (see docs/adr/0025-youtube-analytics-metrics-fetcher.md)
# Copy this file to .env and fill in via `npm run oauth:setup:<channel>` (never commit .env).
#
# This project uploads to 3 separate YouTube channels (one per vertical) — each needs its OWN
# OAuth consent, done with the Google account that has Manager/Owner access to that specific
# channel (verify in YouTube Studio's account switcher first if unsure which account that is).
# The Client ID/Secret below are shared across all 3 consents; only the refresh token differs.

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered on the OAuth client.
# If this port is already used by something else on your machine (e.g. Jenkins on 8080), either
# change it here + on the OAuth client in Google Cloud Console, or use the --exchange-code
# fallback (paste the ?code=... from the browser's address bar) — see src/platforms/youtube-analytics.ts.
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback

# One refresh token per channel — populated automatically by:
#   npm run oauth:setup:finance   (MONEY BLINDSPOT)
#   npm run oauth:setup:health    (Giảm Cân Healthy - Thực Chiến)
#   npm run oauth:setup:aiwork    (Working With AI)
GOOGLE_REFRESH_TOKEN_FINANCE=
GOOGLE_REFRESH_TOKEN_HEALTH=
GOOGLE_REFRESH_TOKEN_AIWORK=
